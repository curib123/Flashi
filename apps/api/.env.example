# Server only. Copy to .env.local; set the same values in Vercel.
OPENAI_API_KEY=
# The model is hardcoded to gpt-5.6-luna. There is no model override/fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Either the legacy service role key or the modern secret key; never both needed.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_WEB_CLIENT_ID=
# Random 32+ character secrets. Never a client variable.
RATE_LIMIT_HASH_KEY=
CRON_SECRET=
INITIAL_CREDITS=10
GENERATION_HOURLY_LIMIT=20
MOBILE_MIN_VERSION=2.0.0
# A separate Flashi App ID from the publisher dashboard; do not reuse another app's ID.
START_IO_APP_ID=
START_IO_ENABLED=false
START_IO_TEST_MODE=true
START_IO_LIBRARY_BANNER=false
