{
  "name": "flashi-monorepo",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "api:dev": "npm --workspace apps/api run dev",
    "api:build": "npm --workspace apps/api run build",
    "api:typecheck": "npm --workspace apps/api run typecheck",
    "test": "npm --workspace apps/api test",
    "check": "npm test && npm run api:typecheck && npm run api:build"
  }
}
